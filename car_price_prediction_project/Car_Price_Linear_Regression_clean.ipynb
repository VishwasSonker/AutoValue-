   "source": [
    "import pickle\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import plotly.express as px\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.tree import DecisionTreeClassifier\n",
    "from sklearn.linear_model import LinearRegression\n",
    "from sklearn.metrics import r2_score, mean_absolute_error, mean_squared_error\n",
    "from math import sqrt"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Load Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "car_data = pd.read_csv(\"car_data.csv\")\n",
    "car_data.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Clean and Prepare the Data"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Remove columns with too many missing values\n",
    "car_data = car_data.drop(\n",
    "    ['Invoice Price', 'Cylinders', 'Highway Fuel Economy'],\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "# Convert horsepower to a numeric feature\n",
    "car_data['Horsepower_no'] = car_data['Horsepower'].str[:3].astype(float)\n",
    "horsepower_mean = car_data.loc[car_data['Make'] == 'Ford', 'Horsepower_no'].mean()\n",
    "\n",
    "car_data['Horsepower_no'] = car_data['Horsepower_no'].fillna(horsepower_mean)\n",
    "car_data['Horsepower'] = car_data['Horsepower'].fillna(horsepower_mean)\n",
    "\n",
    "# Convert torque to a numeric feature\n",
    "car_data['Torque_no'] = car_data['Torque'].str[:3].astype(float)\n",
    "torque_mean = car_data['Torque_no'].mean()\n",
    "\n",
    "car_data['Torque_no'] = car_data['Torque_no'].fillna(torque_mean)\n",
    "car_data['Torque'] = car_data['Torque'].fillna(torque_mean)\n",
    "\n",
    "# Convert prices from strings to numbers\n",
    "for column in ['MSRP', 'Used/New Price']:\n",
    "    car_data[column] = (\n",
    "        car_data[column]\n",
    "        .str.replace(\"$\", \"\", regex=False)\n",
    "        .str.replace(\",\", \"\", regex=False)\n",
    "        .astype(float)\n",
    "    )\n",
    "\n",
    "car_data.isnull().sum()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Exploratory Data Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Numeric feature distributions\n",
    "numeric_features = ['MSRP', 'Used/New Price', 'Horsepower_no', 'Torque_no']\n",
    "\n",
    "for column in numeric_features:\n",
    "    sns.histplot(car_data[column], kde=True)\n",
    "    plt.axvline(car_data[column].mean())\n",
    "    plt.title(column)\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Categorical features vs. MSRP\n",
    "categorical_features = [\n",
    "    'Make', 'Body Size', 'Body Style',\n",
    "    'Engine Aspiration', 'Drivetrain', 'Transmission'\n",
    "]\n",
    "\n",
    "for column in categorical_features:\n",
    "    sns.boxplot(data=car_data, x=column, y='MSRP')\n",
    "    plt.xticks(rotation=45)\n",
    "    plt.title(f\"MSRP by {column}\")\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Relationship between the main numeric features\n",
    "sns.pairplot(\n",
    "    car_data[['MSRP', 'Horsepower_no', 'Torque_no', 'Engine Aspiration']],\n",
    "    hue='Engine Aspiration',\n",
    "    height=4\n",
    ")\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Create the Model Dataset"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "new_car_data = car_data.drop(\n",
    "    ['index', 'Model', 'Year', 'Trim', 'Used/New Price', 'Horsepower', 'Torque'],\n",
    "    axis=1\n",
    ")\n",
    "\n",
    "new_car_data = pd.get_dummies(\n",
    "    new_car_data,\n",
    "    columns=[\n",
    "        'Make', 'Body Size', 'Body Style',\n",
    "        'Engine Aspiration', 'Drivetrain', 'Transmission'\n",
    "    ]\n",
    ")\n",
    "\n",
    "X = new_car_data.drop('MSRP', axis=1)\n",
    "y = new_car_data['MSRP'].astype(int)\n",
    "\n",
    "print(\"Features:\", X.shape)\n",
    "print(\"Target:\", y.shape)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Feature Importance"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Kept equivalent to the original notebook\n",
    "feature_model = DecisionTreeClassifier(\n",
    "    random_state=15,\n",
    "    criterion='entropy',\n",
    "    max_depth=10\n",
    ")\n",
    "feature_model.fit(X, y)\n",
    "\n",
    "final_fi = pd.DataFrame({\n",
    "    'Variable': X.columns,\n",
    "    'Feature Importance Score': feature_model.feature_importances_\n",
    "}).sort_values(\n",
    "    'Feature Importance Score',\n",
    "    ascending=False\n",
    ").reset_index(drop=True)\n",
    "\n",
    "final_fi['Feature Importance Score'] = final_fi['Feature Importance Score'].round(4)\n",
    "final_fi = final_fi.head(27)\n",
    "\n",
    "final_fi.head()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Train the Linear Regression Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y,\n",
    "    train_size=0.80,\n",
    "    test_size=0.20,\n",
    "    random_state=15\n",
    ")\n",
    "\n",
    "model = LinearRegression(fit_intercept=True)\n",
    "model.fit(X_train, y_train)\n",
    "\n",
    "train_pred = model.predict(X_train)\n",
    "test_pred = model.predict(X_test)\n",
    "all_predictions = model.predict(X)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Evaluate the Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"Training R²:\", model.score(X_train, y_train))\n",
    "print(\"Testing R²:\", model.score(X_test, y_test))\n",
    "\n",
    "print(\"Training RMSE:\", sqrt(mean_squared_error(y_train, train_pred)))\n",
    "print(\"Testing RMSE:\", sqrt(mean_squared_error(y_test, test_pred)))\n",
    "\n",
    "print(\"Training MAE:\", mean_absolute_error(y_train, train_pred))\n",
    "print(\"Testing MAE:\", mean_absolute_error(y_test, test_pred))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Save Model and Results"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Save the trained model\n",
    "with open('linear_model.pkl', 'wb') as file:\n",
    "    pickle.dump(model, file)\n",
    "\n",
    "# Save feature importance\n",
    "final_fi.to_excel('feature_importance.xlsx', index=False)\n",
    "\n",
    "# Save predictions with the original data\n",
    "car_data['MSRP Prediction'] = all_predictions\n",
    "car_data.to_excel('data_with_pred.xlsx', index=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Test the Same Input Format Used by the Streamlit App"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def prepare_input(data, feature_list):\n",
    "    return np.array([[data.get(feature, 0) for feature in feature_list]])\n",
    "\n",
    "features = list(X.columns)\n",
    "\n",
    "user_data = {\n",
    "    'Horsepower_no': 300,\n",
    "    'Torque_no': 400,\n",
    "    'Make_Aston Martin': 1,\n",
    "    'Body Size_Compact': 1,\n",
    "    'Engine Aspiration_Naturally Aspirated': 1,\n",
    "    'Drivetrain_AWD': 1,\n",
    "    'Transmission_automatic': 1\n",
    "}\n",
    "\n",
    "input_array = prepare_input(user_data, features)\n",
    "prediction = model.predict(input_array)\n",
    "\n",
    "print(f\"Predicted Price: ${prediction[0]:,.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. Feature Importance Chart"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "feature_plot = final_fi.sort_values('Feature Importance Score')\n",
    "\n",
    "fig = px.bar(\n",
    "    feature_plot,\n",
    "    x='Feature Importance Score',\n",
    "    y='Variable',\n",
    "    orientation='h',\n",
    "    title='Feature Importance',\n",
    "    labels={\n",
    "        'Feature Importance Score': 'Importance',\n",
    "        'Variable': 'Feature'\n",
    "    },\n",
    "    text='Feature Importance Score'\n",
    ")\n",
    "\n",
    "fig.update_layout(\n",
    "    xaxis_title='Feature Importance Score',\n",
    "    yaxis_title='Variable',\n",
    "    template='plotly_white',\n",
    "    height=500\n",
    ")\n",
    "\n",
    "fig.show()"
   ]
  },
 ],
